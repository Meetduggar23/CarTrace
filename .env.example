# ------------------------------------------------------------------
# CarTrace — environment configuration
# Copy this file to .env and fill in values. Never commit .env.
# ------------------------------------------------------------------

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for the frontend (no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Log verbosity: debug | info | warn | error (defaults to debug in dev, info in prod)
LOG_LEVEL=debug

# --- Database (PostgreSQL, optional at runtime) ---
# The app runs without a database (auth/saved-vehicles/history disabled).
# Set this to enable user accounts and persistence.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cartrace

# --- Cache ---
# Leave REDIS_URL empty to use the built-in in-memory cache.
REDIS_URL=
# Cache TTL for vehicle lookups, in seconds.
VEHICLE_CACHE_TTL=3600

# --- Vehicle providers ---
# Mock provider (development only). If enabled, vehicle lookups work
# without any third-party credentials and are clearly labeled as mock data.
MOCK_VEHICLE_PROVIDER=true

# NHTSA vPIC is free and needs no key. Override the base URL if needed.
NHTSA_API_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles

# CarAPI (freemium, needs an account). Provider is only enabled when the
# key is set. See docs/API_PROVIDERS.md for details.
CARAPI_API_KEY=
CARAPI_API_BASE_URL=https://api.carapi.app

# --- Auth ---
# Strong secret for signing JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Rate limiting (requests per window) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
AUTH_RATE_LIMIT_MAX=10

# --- Frontend (build-time) ---
# Base URL of the backend API used by the frontend. Leave unset to fall back
# to http://localhost:4000 in development and /api (same-origin) in production.
VITE_API_URL=http://localhost:4000
